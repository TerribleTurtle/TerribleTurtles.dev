{
  "name": "terribleturtles-dev",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run typecheck && npm run typecheck:scripts && npm run lint:js && npm run lint:css && npm run test:unit && npm run check:contrast && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.{css,astro}\"",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test": "playwright test",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "assets:icons": "node scripts/generate-icons.mjs",
    "assets:og": "node scripts/generate-og.mjs",
    "assets:screenshot": "node scripts/capture-screenshot.mjs",
    "prepare": "husky",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test:security": "playwright test --project=headers --project=chromium --project=firefox --project=webkit tests/security",
    "verify:security": "npm run build && npm run verify:dist && playwright test",
    "audit:deps": "node scripts/audit-deps.mjs",
    "audit:signatures": "npm audit signatures",
    "check:live": "node scripts/live-check.mjs",
    "check:observatory": "node scripts/observatory.mjs",
    "check:dns": "node scripts/dns-audit.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.19",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.14.0",
    "stylelint-config-astro": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "lint-staged": {
    "*.{js,ts,mjs}": "eslint",
    "*.{css,astro}": "stylelint"
  }
}
