---
import type { CollectionEntry } from 'astro:content';
import StatusLabel from './StatusLabel.astro';

/** The work index: one hairline-divided row per project. Reads fine with a single entry. */
interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<ul class="work-list">
  {
    projects.map((project) => (
      <li class="row">
        <h3 class="row-title">
          <a href={`/work/${project.id}/`}>{project.data.title}</a>
        </h3>
        <p class="row-summary">{project.data.summary}</p>
        <p class="row-meta">
          <span>{project.data.year}</span>
          <span aria-hidden="true">·</span>
          <StatusLabel status={project.data.status} />
        </p>
      </li>
    ))
  }
</ul>

<style>
  .work-list {
    padding: 0;
    list-style: none;
    border-block-start: var(--border-hairline) solid var(--color-hairline);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "title meta"
      "summary summary";
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-4);
    border-block-end: var(--border-hairline) solid var(--color-hairline);
  }

  .row-title {
    grid-area: title;
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  /* Whole row is clickable; the accessible name stays the project title. */
  .row-title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .row-title a {
    display: inline-block;
    transition: color var(--duration-fast) var(--ease-out),
      translate var(--duration-base) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .row:hover .row-title a {
      color: var(--color-text);
      translate: var(--nudge) 0;
    }

    :dir(rtl) .row:hover .row-title a {
      translate: var(--nudge-rtl) 0;
    }
  }

  .row-summary {
    grid-area: summary;
    color: var(--color-text-muted);
  }

  .row-meta {
    grid-area: meta;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--step-minus-1);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
