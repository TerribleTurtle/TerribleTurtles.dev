---
import type { CollectionEntry } from 'astro:content';
import { splitLocale, type Locale } from '../i18n/locales';
import { t } from '../i18n/ui';

/**
 * Project status as text plus a small dot. The text carries the meaning;
 * the dot shape also differs per status, so colour is never the only cue.
 */
type Status = CollectionEntry<'projects'>['data']['status'];

interface Props {
  status: Status;
  locale?: Locale;
}

const { status } = Astro.props;
const { locale: pathLocale } = splitLocale(Astro.url.pathname);
const locale = Astro.props.locale ?? pathLocale;

const statusKeys: Record<Status, 'status.live' | 'status.experimental' | 'status.archived'> = {
  live: 'status.live',
  experimental: 'status.experimental',
  archived: 'status.archived',
};
---

<span class="status">
  <span class:list={['dot', `dot-${status}`]} aria-hidden="true"></span>
  {t(locale, statusKeys[status])}
</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .dot {
    width: var(--dot-size);
    height: var(--dot-size);
    border-radius: var(--radius-round);
    border: var(--border-hairline) solid var(--color-accent);
  }

  /* Live: filled. Experimental: ring. Archived: muted ring. */
  .dot-live {
    background-color: var(--color-accent);
  }

  .dot-archived {
    border-color: var(--color-text-muted);
  }

  @media (forced-colors: active) {
    .dot {
      forced-color-adjust: none;
    }
  }
</style>
