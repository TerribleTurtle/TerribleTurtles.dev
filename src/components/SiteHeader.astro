---
import ScuteMark from './ScuteMark.astro';
import { splitLocale, localizePath, locales, LOCALE_META, type Locale } from '../i18n/locales';
import { t } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

/**
 * Site header: mark + wordmark (home link) and the primary nav.
 * The home page is the work index, so "Work" points to "/" and is marked as
 * the current section on project pages.
 */
const { locale: pathLocale, basePath } = splitLocale(Astro.url.pathname);
const locale = Astro.props.locale ?? pathLocale;
const isNotFound = basePath.startsWith('/404');

const navItems = [
  { href: localizePath(locale, '/'), label: t(locale, 'nav.work'), current: basePath === '/' ? 'page' : basePath.startsWith('/work/') ? 'true' : undefined },
  { href: localizePath(locale, '/about/'), label: t(locale, 'nav.about'), current: basePath === '/about/' ? 'page' : undefined },
] as const;
---

<header class="site-header wrap">
  <a class="brand" href={localizePath(locale, '/')} aria-label={t(locale, 'brand.homeLabel')}>
    <ScuteMark />
    <span class="wordmark">TerribleTurtles</span>
  </a>
  <div class="header-nav">
    <nav aria-label={t(locale, 'nav.primaryLabel')}>
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={item.current}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label={t(locale, 'lang.switcherLabel')}>
      <ul class="lang-list">
        {
          locales.map((targetLocale) => {
            const targetMeta = LOCALE_META[targetLocale];
            const isCurrent = targetLocale === locale;
            const targetHref = isNotFound ? localizePath(targetLocale, '/') : localizePath(targetLocale, basePath);
            return (
              <li>
                {
                  isCurrent ? (
                    <span aria-current="true" lang={targetMeta.bcp47}>
                      {targetMeta.label}
                    </span>
                  ) : (
                    <a href={targetHref} hreflang={targetMeta.bcp47} lang={targetMeta.bcp47}>
                      {targetMeta.label}
                    </a>
                  )
                }
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
    view-transition-name: site-header;
  }

  .header-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-min);
    gap: var(--space-3);
    color: var(--color-text);
    text-decoration: none;
  }

  .wordmark {
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-tight);
  }

  .brand :global(.scute-mark) {
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .nav-list,
  .lang-list {
    display: flex;
    flex-wrap: wrap;
    padding: 0;
    list-style: none;
  }

  .nav-list {
    gap: var(--space-5);
  }

  .lang-list {
    gap: var(--space-3);
    font-size: var(--step-minus-1);
  }

  nav a,
  nav span {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-min);
  }

  nav a {
    text-decoration-color: transparent;
  }

  nav a[aria-current] {
    text-decoration-color: currentcolor;
  }

  .lang-list span[aria-current="true"] {
    color: var(--color-text-muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover {
      color: var(--color-text);
    }

    .brand:hover :global(.scute-mark) {
      transform: rotate(var(--mark-turn));
    }

    nav a:hover {
      text-decoration-color: currentcolor;
    }
  }
</style>
