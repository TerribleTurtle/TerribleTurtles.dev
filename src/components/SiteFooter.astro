---
import { splitLocale, localizePath, type Locale } from '../i18n/locales';
import { t, format } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

/** Site footer: secondary links and licence line. */
const { locale: pathLocale } = splitLocale(Astro.url.pathname);
const locale = Astro.props.locale ?? pathLocale;
const year = new Date().getFullYear();
---

<footer class="wrap">
  <div class="site-footer">
    <nav aria-label={t(locale, 'footer.navLabel')}>
      <ul>
        <li><a href="https://github.com/TerribleTurtle">GitHub</a></li>
        <li><a href={localizePath(locale, '/privacy/')}>{t(locale, 'footer.privacy')}</a></li>
        <li><a href={localizePath(locale, '/security/')}>{t(locale, 'footer.security')}</a></li>
      </ul>
    </nav>
    <p class="colophon">
      <span>{format(t(locale, 'footer.copyright'), { year })}</span>
      <span aria-hidden="true">·</span>
      <span>{t(locale, 'footer.codeLicense')}</span>
      <span aria-hidden="true">·</span>
      <span>{t(locale, 'footer.writingLicense')}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    padding-block: var(--space-6)
      max(var(--space-7), calc(var(--space-7) + env(safe-area-inset-bottom)));
    border-block-start: var(--border-hairline) solid var(--color-hairline);
    text-align: center;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-min);
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--step-minus-1);
  }
</style>
