---
/** Site footer: secondary links, licence line and font credits. */
const year = new Date().getFullYear();
---

<footer class="wrap">
  <div class="site-footer">
    <nav aria-label="Footer">
      <ul>
        <li><a href="https://github.com/TerribleTurtle">GitHub</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/security/">Security</a></li>
      </ul>
    </nav>
    <p class="colophon">
      <span>© {year} TerribleTurtles</span>
      <span aria-hidden="true">·</span>
      <span>Code MIT</span>
      <span aria-hidden="true">·</span>
      <span>Writing CC BY-NC 4.0</span>
    </p>
    <p class="credits">
      Set in <a href="/fonts/Newsreader-OFL.txt">Newsreader</a> and
      <a href="/fonts/InstrumentSans-OFL.txt">Instrument Sans</a> (SIL Open Font License).
    </p>
  </div>
</footer>

<style>
  .site-footer {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    padding-block: var(--space-6) var(--space-7);
    border-block-start: var(--border-hairline) solid var(--color-hairline);
    text-align: center;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--step-minus-1);
  }

  .credits {
    color: var(--color-text-muted);
    font-size: var(--step-minus-1);
  }

  .credits a {
    color: inherit;
  }

  .credits a:hover {
    color: var(--color-text);
  }
</style>
