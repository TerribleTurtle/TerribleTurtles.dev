---
/**
 * Scute mark: an irregular seven-sided plate with two growth rings that
 * converge on an off-centre growth point, like a real turtle scute.
 * Decorative only (aria-hidden); the surrounding link carries the name.
 * Geometry is shared with public/favicon.svg and scripts/generate-og.mjs.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['scute-mark', className]}
  viewBox="0 0 32 32"
  width="32"
  height="32"
  aria-hidden="true"
  focusable="false"
>
  <polygon points="14.58,2.47 25.35,8.16 29.39,16.47 23.46,24.89 9.71,27.83 4.26,18.49 4.83,9.55"></polygon>
  <polygon points="14.59,8.37 21.26,11.9 23.77,17.05 20.09,22.27 11.57,24.1 8.19,18.31 8.54,12.76"></polygon>
  <polygon points="14.3,14.39 17.21,15.93 18.3,18.17 16.7,20.44 12.99,21.24 11.52,18.72 11.67,16.3"></polygon>
</svg>

<style>
  .scute-mark {
    width: var(--mark-size);
    height: var(--mark-size);
    flex: none;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: var(--mark-stroke);
    stroke-linejoin: round;
  }

  @media (forced-colors: active) {
    .scute-mark {
      forced-color-adjust: none;
      stroke: CanvasText;
    }
  }
</style>
