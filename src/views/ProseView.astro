---
import { getEntry, render } from 'astro:content';
import ProseLayout from '../layouts/ProseLayout.astro';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;

const entry = await getEntry('pages', `${locale}/${slug}`);
if (!entry) {
  throw new Error(`Missing page content for ${locale}/${slug}`);
}

const extraGraph: Record<string, unknown>[] = entry.data.profilePage
  ? [
      {
        '@type': 'ProfilePage',
        mainEntity: { '@id': 'https://terribleturtles.dev/#person' },
      },
    ]
  : [];

const { Content } = await render(entry);
---

<ProseLayout
  title={entry.data.title}
  description={entry.data.description}
  updated={entry.data.updated}
  extraGraph={extraGraph}
  locale={locale}
  legal={entry.data.legal}
>
  <Content />
</ProseLayout>
