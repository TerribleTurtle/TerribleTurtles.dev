---
import { getEntry, render } from 'astro:content';
import ProseLayout from '../layouts/ProseLayout.astro';
import { splitLocale } from '../i18n/locales';

const { locale } = splitLocale(Astro.url.pathname);
const entry = await getEntry('pages', `${locale}/about`);
if (!entry) throw new Error(`Missing page content for ${locale}/about`);
const { Content } = await render(entry);

const extraGraph: Record<string, unknown>[] = [
  {
    '@type': 'ProfilePage',
    mainEntity: { '@id': 'https://terribleturtles.dev/#person' },
  },
];
---

<ProseLayout
  title={entry.data.title}
  description={entry.data.description}
  extraGraph={extraGraph}
  locale={locale}
>
  <Content />
</ProseLayout>
