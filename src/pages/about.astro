---
import BaseLayout from '../layouts/BaseLayout.astro';

const extraGraph: Record<string, unknown>[] = [
  {
    '@type': 'ProfilePage',
    mainEntity: { '@id': 'https://terribleturtles.dev/#person' },
  },
];
---

<BaseLayout
  title="About | TerribleTurtles"
  description="About TerribleTurtles and this site."
  extraGraph={extraGraph}
>
  <h1 class="page-title">About</h1>
  <div class="prose">
    <p>I'm TerribleTurtles. I build things when something seems worth making.</p>
    <p>
      My code is on <a href="https://github.com/TerribleTurtle">GitHub</a>, including{' '}
      <a href="https://github.com/TerribleTurtle/TerribleTurtles.dev">the source for this site</a>.
    </p>
    <p>You can reach me at <a href="mailto:hello@terribleturtles.dev">hello@terribleturtles.dev</a>.</p>
  </div>
</BaseLayout>
