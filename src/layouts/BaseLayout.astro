---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { LOCALE_META, defaultLocale, locales, localizePath, splitLocale } from '../i18n/locales';
import { t } from '../i18n/ui';

import type { Locale } from '../i18n/locales';

interface Props {
  title?: string;
  description?: string;
  /** Root-relative path to the social preview image (1200×630). */
  ogImage?: string;
  image?: string;
  imageAlt?: string;
  /** Set on pages that must not be indexed (e.g. 404). */
  noindex?: boolean;
  /** Extra nodes to append to the JSON-LD @graph. */
  extraGraph?: Record<string, unknown>[];
  locale?: Locale;
}

const siteName = 'TerribleTurtles';
// The locale comes from the URL, so every page gets the right lang/dir without passing props.
const { locale: pathLocale, basePath } = splitLocale(Astro.url.pathname);
const locale = Astro.props.locale ?? pathLocale;

const {
  title = siteName,
  description = t(locale, 'meta.defaultDescription'),
  ogImage,
  image = '/og.png',
  imageAlt = t(locale, 'meta.defaultImageAlt'),
  noindex = false,
  extraGraph = [],
} = Astro.props;

if (!Astro.site) {
  throw new Error('`site` must be set in astro.config.mjs for canonical and OG URLs.');
}

const siteURL = Astro.site;
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const socialImageURL = new URL(ogImage ?? image, siteURL);

const meta = LOCALE_META[locale];
const alternates = locales.map((l) => ({ hreflang: LOCALE_META[l].bcp47, href: new URL(localizePath(l, basePath), siteURL) }));
const xDefault = new URL(localizePath(defaultLocale, basePath), siteURL);

// Inline JSON-LD is a non-executable data block (`application/ld+json`),
// so it is not subject to `script-src` and does not weaken the CSP.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', siteURL).toString(),
      name: siteName,
      url: siteURL.toString(),
      inLanguage: locales.map((l) => LOCALE_META[l].bcp47),
      author: { '@id': new URL('/#person', siteURL).toString() },
    },
    {
      '@type': 'Person',
      '@id': new URL('/#person', siteURL).toString(),
      name: siteName,
      url: siteURL.toString(),
      sameAs: ['https://github.com/TerribleTurtle'],
    },
    ...extraGraph,
  ],
});
---

<!doctype html>
<html lang={meta.bcp47} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />
    {
      !noindex && locales.length > 1 && (
        <>
          {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
          <link rel="alternate" hreflang="x-default" href={xDefault} />
        </>
      )
    }
    <meta name="color-scheme" content="dark light" />

    <link
      rel="preload"
      href="/fonts/newsreader-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.ogLocale} />
    {locales.filter((l): boolean => l !== locale).map((l) => <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />)}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body>
    <a href="#main" class="skip-link">{t(locale, 'skip.main')}</a>
    <SiteHeader locale={locale} />
    <main id="main" tabindex="-1" class="wrap">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
