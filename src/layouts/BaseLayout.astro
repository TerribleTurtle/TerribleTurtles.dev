---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Root-relative path to the social preview image. */
  image?: string;
  /** Set on pages that must not be indexed (e.g. 404). */
  noindex?: boolean;
}

const siteName = 'TerribleTurtles';
const {
  title = siteName,
  description = 'A personal archive of things I have built.',
  image = '/og.png',
  noindex = false,
} = Astro.props;

if (!Astro.site) {
  throw new Error('`site` must be set in astro.config.mjs for canonical and OG URLs.');
}

const siteURL = Astro.site;
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const socialImageURL = new URL(image, siteURL);
const pathname = Astro.url.pathname;

const primaryNav = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
];

// Inline JSON-LD is a non-executable data block (`application/ld+json`),
// so it is not subject to `script-src` and does not weaken the CSP.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', siteURL).toString(),
      name: siteName,
      url: siteURL.toString(),
      author: { '@id': new URL('/#person', siteURL).toString() },
    },
    {
      '@type': 'Person',
      '@id': new URL('/#person', siteURL).toString(),
      name: siteName,
      url: siteURL.toString(),
      sameAs: ['https://github.com/TerribleTurtle'],
    },
  ],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <header class="site-header">
      <nav aria-label="Primary">
        <ul>
          {
            primaryNav.map((item) => (
              <li>
                <a href={item.href} aria-current={pathname === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <nav aria-label="Footer">
        <ul>
          <li><a href="https://github.com/TerribleTurtle">GitHub</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/security/">Security</a></li>
        </ul>
      </nav>
    </footer>
  </body>
</html>
