{
  // Strict JSDoc type-checking for Node build scripts and unit tests (`npm run typecheck:scripts`).
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["./**/*.mjs", "../tests/unit/**/*.mjs"]
}
