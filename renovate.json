{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:allNonMajor"
  ],
  "schedule": [
    "* 0-3 1,15 * *"
  ],
  "lockFileMaintenance": {
    "schedule": [
      "* 0-3 1,15 * *"
    ]
  },
  "minimumReleaseAge": "5 days",
  "internalChecksFilter": "strict",
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
