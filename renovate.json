{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:allNonMajor"
  ],
  "schedule": [
    "* 0-3 1 * *"
  ],
  "updateNotScheduled": false,
  "lockFileMaintenance": {
    "automerge": true,
    "schedule": [
      "* 0-3 1 * *"
    ]
  },
  "minimumReleaseAge": "5 days",
  "internalChecksFilter": "strict",
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": [
        "/^stylelint/"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "stylelint"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
