{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-13",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "popular-point",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "terribleturtles-db",
			"database_id": "REDACTED"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CONFIG_KV",
			"id": "REDACTED"
		}
	]
}