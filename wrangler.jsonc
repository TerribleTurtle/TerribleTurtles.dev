{
  // Workers Static Assets only: there is deliberately NO `main` Worker script (pure static site).
  // Security headers live in public/_headers, never here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terribleturtles-dev",
  // Must not be later than the workerd bundled with the installed wrangler (workerd 1.20261001.x).
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // `/about/index.html` is served at `/about/`; `/about` answers 307 → `/about/`.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with HTTP status 404.
    "not_found_handling": "404-page"
  },
  "preview_urls": true
}